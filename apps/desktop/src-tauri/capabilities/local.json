{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-capability",
  "description": "Capabilities for local windows (bar fallback and overlay)",
  "windows": ["bar", "overlay"],
  "local": true,
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-bar-report",
    "allow-bar-reconnect",
    "allow-overlay-compose-done"
  ]
}
