{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-dsh-capability",
  "description": "Allow Bar window loaded from local DSH HTTP server to call Tauri commands",
  "windows": ["bar"],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://127.0.0.1:*/*",
      "http://localhost:*",
      "http://localhost:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-bar-report",
    "allow-bar-reconnect",
    "allow-bar-drag-begin",
    "allow-bar-drag-step",
    "allow-bar-drag-end",
    "allow-bar-drag-reset",
    "allow-bar-get-dock-state",
    "allow-bar-set-dock-edge",
    "allow-bar-set-vertical-mode",
    "allow-bar-set-dock-unread",
    "allow-bar-dock-expand",
    "allow-harness-get-active",
    "allow-harness-set-active",
    "allow-harness-list-available",
    "allow-harness-list-options",
    "allow-harness-load-catalog",
    "allow-harness-load-messages",
    "allow-harness-send-message",
    "allow-harness-cancel-turn",
    "allow-harness-focus-desktop",
    "allow-harness-session-stats",
    "allow-harness-session-state",
    "allow-harness-upsert-custom-acp",
    "allow-harness-remove-custom-acp",
    "allow-universal-get-target",
    "allow-app-get-settings",
    "allow-app-update-settings",
    "allow-app-settings-action",
    "allow-app-ensure-default-workspace",
    "allow-app-pick-folder",
    "allow-app-pick-files",
    "allow-app-read-clipboard-files",
    "allow-app-describe-paths",
    "allow-app-save-clipboard-image",
    "allow-quick-search-query",
    "allow-quick-search-status",
    "allow-quick-search-build-capsule",
    "allow-quick-search-open-path",
    "allow-quick-search-refresh",
    "allow-pick-list-profiles",
    "allow-pick-reset-profile",
    "allow-pick-export-profile",
    "allow-pick-import-profile",
    "allow-adapter-plugins-list",
    "allow-adapter-plugins-reload",
    "allow-adapter-plugins-set-enabled",
    "allow-adapter-plugins-install-url",
    "allow-adapter-plugins-install-json",
    "allow-adapter-plugins-install-file",
    "allow-adapter-plugins-uninstall",
    "allow-adapter-plugins-export",
    "allow-adapter-plugins-fetch-registry",
    "allow-adapter-plugins-test",
    "allow-adapter-plugins-open-dir",
    "allow-vision-get-config",
    "allow-vision-probe-hardware",
    "allow-vision-update-config",
    "allow-vision-test-pipeline",
    "allow-vision-unload-models"
  ]
}
